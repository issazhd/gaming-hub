<Application x:Class="GamingHub.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GamingHub.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <local:NotNullToVisibility x:Key="NotNull" />
        <local:InverseBoolToVisibility x:Key="NotVis" />
        <local:PathToImage x:Key="Img" />
        <local:EqualsToVisibility x:Key="Is" />
        <SolidColorBrush x:Key="Fg" Color="#F5F5F5" />
        <SolidColorBrush x:Key="Dim" Color="#B8B8B8" />
        <SolidColorBrush x:Key="Accent" Color="#305985" />
        <SolidColorBrush x:Key="Card" Color="#DF151D2B" />

        <SolidColorBrush x:Key="PanelEdge" Color="#536178" />
        <SolidColorBrush x:Key="MissingArt" Color="#404040" />
        <SolidColorBrush x:Key="NeutralAction" Color="#494949" />
        <SolidColorBrush x:Key="ControlSurface" Color="#DD283244" />
        <SolidColorBrush x:Key="ToggleSurface" Color="#10FFFFFF" />
        <SolidColorBrush x:Key="ToggleFocusText" Color="#F5F5F5" />
        <SolidColorBrush x:Key="ToggleActive" Color="#686868" />
        <SolidColorBrush x:Key="ToggleFocus" Color="#3F3F3F" />
        <SolidColorBrush x:Key="SettingsAction" Color="#BA654743" />
        <SolidColorBrush x:Key="HoverSurface" Color="#405574" />
        <SolidColorBrush x:Key="FocusHighlight" Color="#FFFFFF" />
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#080C15" Offset="0" />
            <GradientStop Color="#101929" Offset="0.7" />
            <GradientStop Color="#26364C" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="PanelSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <DataTemplate x:Key="PadIcon">
            <Viewbox Width="40" Height="24">
                <Canvas Width="60" Height="36">
                    <Path Stroke="#F5F5F5" StrokeThickness="2.4" Fill="#48535353" StrokeLineJoin="Round"
                          Data="M16,4 Q20,2 24,4 H36 Q40,2 44,4 C50,5 52,10 54,16 L57,28 C58,33 54,35 50,32 L42,25 Q39,23 36,24 H24 Q20,23 18,25 L10,32 C6,35 2,33 3,28 L6,16 C8,10 10,5 16,4 Z" />
                    <Path Stroke="#B6B6B6" StrokeThickness="1.5" Fill="#969696" Data="M21,6 Q30,4 39,6 L37,13 Q30,15 23,13 Z" />
                    <Path Stroke="#F2F2F2" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M14,10 V17 M10.5,13.5 H17.5 M43,11 h1 M46,14 h1 M40,14 h1 M43,17 h1" />
                    <Ellipse Canvas.Left="19" Canvas.Top="16" Width="6" Height="6" Stroke="#F2F2F2" StrokeThickness="1.6" />
                    <Ellipse Canvas.Left="35" Canvas.Top="16" Width="6" Height="6" Stroke="#F2F2F2" StrokeThickness="1.6" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="{StaticResource ControlSurface}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="24" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource HoverSurface}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource FocusHighlight}" /><Setter Property="Foreground" Value="#181818" /></Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Background" Value="{StaticResource SettingsAction}" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="#595959" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <!-- always-visible focus (WPF's focus outline only appears after keyboard input, not controller) -->
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource FocusHighlight}" />
                    <Setter Property="FontWeight" Value="SemiBold" />

                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Slim modern scrollbars: no arrows, invisible track, rounded thumb that brightens and widens on hover -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" Background="#4DFFFFFF" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#8CFFFFFF" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource FocusHighlight}" /><Setter Property="Foreground" Value="#181818" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Margin" Value="6,4,2,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" /></Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Width" Value="12" /></Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track"><Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" /></Track.Thumb></Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="Background" Value="#151515" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#353535" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#505050" />

                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
