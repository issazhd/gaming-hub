<Window x:Class="GamingHub.App.QuickMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gaming Hub quick menu" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource ShellBackground}" Foreground="{StaticResource Fg}" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#111111" Offset="0" />
            <GradientStop Color="#303030" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Accent" Color="#777777" />
        <SolidColorBrush x:Key="HoverSurface" Color="#585858" />
        <SolidColorBrush x:Key="PanelEdge" Color="#505050" />
        <SolidColorBrush x:Key="Ink" Color="#121212" />

        <!-- Circular shortcut above its label -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2">
                            <StackPanel VerticalAlignment="Center">
                                <Border x:Name="well" Width="36" Height="36" CornerRadius="18" Background="{StaticResource NeutralAction}" HorizontalAlignment="Center">
                                    <TextBlock x:Name="glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="well" Property="Background" Value="{StaticResource HoverSurface}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="well" Property="Background" Value="{StaticResource FocusHighlight}" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round icon button (mute) -->
        <Style x:Key="IconOnly" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Width="44" Height="44" CornerRadius="22" Background="{StaticResource NeutralAction}">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource HoverSurface}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource FocusHighlight}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Screen chip -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="{StaticResource NeutralAction}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="22" Background="{TemplateBinding Background}" Padding="16,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource FocusHighlight}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume slider: thin track, accent fill, round thumb that turns white when focused -->
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="44" Background="Transparent">
                            <Border x:Name="rail" Height="6" CornerRadius="3" Background="{StaticResource NeutralAction}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="{StaticResource Accent}" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="e" Width="20" Height="20" Fill="#CFCFCF" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="rail" Property="Background" Value="#888888" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Backdrop">
    <Border x:Name="OverlayCard" Background="#F5151515" CornerRadius="12"
            KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
        <DockPanel Margin="20,18">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{Binding Clock}" DockPanel.Dock="Right" Margin="12,0,0,0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Quick menu" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Footer -->
            <TextBlock DockPanel.Dock="Bottom" FontSize="14" Foreground="{StaticResource Dim}" Margin="0,16,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Esc   Close" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UsingController}" Value="True"><Setter Property="Text" Value="○   Close" /></DataTrigger>
                            <DataTrigger Binding="{Binding OverGame, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Text" Value="Esc   Return to game" /></DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding OverGame, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    <Condition Binding="{Binding UsingController}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="○   Return to game" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,6,0">
                <Border x:Name="SessionCard" Style="{StaticResource PanelSurface}" Background="#292929" BorderBrush="{StaticResource PanelEdge}" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="CoverBox" DockPanel.Dock="Left" Width="34" Height="48" Margin="0,0,12,0" CornerRadius="4" Background="{StaticResource MissingArt}">
                                <Border CornerRadius="4">
                                <Border.Background><ImageBrush x:Name="Cover" Stretch="UniformToFill" /></Border.Background></Border>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StateText" Foreground="{StaticResource FocusHighlight}" FontSize="13" />
                                <TextBlock x:Name="GameTitle" FontWeight="SemiBold" FontSize="21" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <Border BorderBrush="{StaticResource PanelEdge}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,7,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="Sound output" FontSize="14" Foreground="{StaticResource Dim}" />
                                <TextBlock Grid.Column="1" x:Name="OutputName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="Controllers" FontSize="14" Foreground="{StaticResource Dim}" Margin="0,5,0,0" />
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,3,0,0">
                                    <TextBlock Text="None connected" Foreground="{StaticResource Dim}" Visibility="{Binding HasPads, Converter={StaticResource NotVis}}" />
                                    <ItemsControl x:Name="PadReadings" ItemsSource="{Binding Pads}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,14,2" ToolTip="{Binding Tooltip}" VerticalAlignment="Center">
                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PadIcon}" Focusable="False" AutomationProperties.Name="{Binding Tooltip}" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Player, StringFormat=P{0}}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding BatteryText}" Foreground="{StaticResource Fg}" />
                                                    <TextBlock Text=" ⚡" Foreground="{StaticResource FocusHighlight}" Visibility="{Binding Charging, Converter={StaticResource Vis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="StatusText" FontSize="14" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                        <TextBlock Text="{Binding Toast}" Visibility="{Binding Toast, Converter={StaticResource NotNull}}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Volume -->
                <TextBlock Text="Sound" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,0,0,6" />
                <DockPanel Margin="0,0,0,18">
                    <Button x:Name="MuteButton" DockPanel.Dock="Left" Style="{StaticResource IconOnly}" Tag="&#xE767;" Click="ToggleMute" ToolTip="Mute" />
                    <Button x:Name="OutputButton" DockPanel.Dock="Left" Style="{StaticResource IconOnly}" Tag="&#xE7F5;" Click="ToggleOutputs" ToolTip="Sound output" Margin="8,0,0,0" />
                    <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" FontSize="15" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                            Margin="18,0,8,0" ValueChanged="VolumeChanged" />
                </DockPanel>

                <!-- Sound outputs: folded away until the speakers button next to Mute is pressed -->
                <StackPanel x:Name="OutputPanel" Visibility="Collapsed" Margin="0,-8,0,18">
                    <TextBlock Text="Play sound on" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,0,0,8" />
                    <WrapPanel x:Name="OutputList" />
                </StackPanel>


                <!-- Actions -->
                <Border CornerRadius="24" Background="#12FFFFFF" Margin="0,0,0,12">
                <UniformGrid Columns="3">
                    <Button Style="{StaticResource TileButton}" Tag="&#xE80F;" Content="Home" Click="GoToHub" />
                    <Button x:Name="GameAction" Style="{StaticResource TileButton}" Tag="&#xE768;" Content="Return to game" Click="OpenGameAction" />
                    <Button Style="{StaticResource TileButton}" Tag="&#xE713;" Content="Settings" Click="OpenSettings" />
                    <Button Style="{StaticResource TileButton}" Tag="&#xE7E8;" Content="Power" Click="OpenPower" />
                    <Button Style="{StaticResource TileButton}" Tag="&#xE921;" Content="Minimize" Click="MinimizeHub" />
                    <Button x:Name="CloseGameButton" Style="{StaticResource TileButton}" Tag="&#xE711;" Content="Close game" Click="CloseGame" />
                </UniformGrid>
                </Border>

                <StackPanel x:Name="RecentList" Visibility="Collapsed" Margin="0,0,0,12" />

                <!-- Screens -->
                <TextBlock Text="Show Gaming Hub on" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,0,0,8" />
                <WrapPanel x:Name="DisplayButtons" />
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
    </Grid>
</Window>
